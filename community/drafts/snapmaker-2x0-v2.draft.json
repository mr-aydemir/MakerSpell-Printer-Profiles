{
  "$schema": "../schema/profile-v2.schema.json",
  "schemaVersion": 2,
  "id": "community.snapmaker-2x0-v2.draft",
  "version": "0.2.0",
  "identity": {
    "name": "Snapmaker 2.0 family (LAN status)",
    "models": [
      "Snapmaker A250",
      "Snapmaker A350",
      "Snapmaker Artisan"
    ],
    "status": "experimental",
    "extruderCount": 1
  },
  "permissions": [
    "statusRead",
    "fileUpload"
  ],
  "credentials": {
    "token": {
      "kind": "query",
      "parameterName": "token",
      "note": "Pairing token approved on the printer touchscreen via POST /api/v1/connect."
    }
  },
  "supportedFileTypes": [
    "gcode"
  ],
  "printPreparation": {
    "filamentMappingMode": "unsupported",
    "calibrationMode": "unsupported",
    "autoLevelingMode": "unsupported",
    "supportsFlowCalibration": false,
    "supportsTimelapseCapture": false
  },
  "discovery": {
    "serviceTypes": [
      "_snapmaker._tcp.local"
    ],
    "ports": [
      8080
    ],
    "probes": [
      {
        "operation": "probeStatus",
        "weight": 5,
        "required": true
      }
    ]
  },
  "channels": {
    "api": {
      "kind": "http",
      "scheme": "http",
      "port": 8080,
      "timeoutMs": 8000,
      "maxResponseBytes": 8388608
    }
  },
  "operations": {
    "probeStatus": {
      "channel": "api",
      "permission": "statusRead",
      "method": "GET",
      "path": "/api/v1/status",
      "send": {
        "query": {
          "token": "{{token}}"
        }
      },
      "map": "status"
    },
    "connect": {
      "channel": "api",
      "permission": "statusRead",
      "method": "POST",
      "path": "/api/v1/connect"
    },
    "enclosureStatus": {
      "channel": "api",
      "permission": "statusRead",
      "method": "GET",
      "path": "/api/v1/enclosure",
      "send": {
        "query": {
          "token": "{{token}}"
        }
      },
      "map": "enclosureStatus"
    },
    "uploadFile": {
      "channel": "api",
      "permission": "fileUpload",
      "method": "POST",
      "path": "/api/v1/upload",
      "send": {
        "query": {
          "token": "{{token}}"
        },
        "multipart": {
          "files": [
            {
              "field": "file",
              "filename": "{{remoteFilename}}",
              "bytesVariable": "gcodeBytes"
            }
          ]
        }
      }
    }
  },
  "state": {
    "identity": {
      "printer.identity.model": {
        "paths": [
          "$.model",
          "$.machine_model"
        ]
      }
    },
    "status": {
      "printer.connection.state": {
        "path": "$.status",
        "enum": {
          "IDLE": "idle",
          "RUNNING": "printing",
          "PAUSED": "paused"
        }
      },
      "printer.job.state": "$.status",
      "printer.job.filename": "$.fileName",
      "printer.job.progress": "$.progress",
      "printer.job.elapsed": "$.elapsedTime",
      "printer.job.remaining": "$.remainingTime",
      "printer.temperatures.nozzle.actual": "$.nozzleTemperature",
      "printer.temperatures.nozzle.target": "$.nozzleTargetTemperature",
      "printer.temperatures.bed.actual": "$.heatedBedTemperature",
      "printer.temperatures.bed.target": "$.heatedBedTargetTemperature",
      "printer.motion.position": {
        "paths": [
          "$.x",
          "$.y",
          "$.z"
        ]
      },
      "printer.motion.homedAxes": "$.homed",
      "printer.motion.feedRate": "$.workSpeed",
      "printer.extruders.items": {
        "compose": [
          {
            "index": {
              "value": 0
            },
            "id": {
              "value": "t0"
            },
            "label": {
              "value": "Extruder"
            },
            "temperature": "$.nozzleTemperature",
            "target": "$.nozzleTargetTemperature"
          }
        ]
      }
    }
  },
  "verification": {
    "level": "unverified",
    "notes": [
      "Status/connect/enclosure endpoints reverse-engineered from community projects (NiteCrwlr/playground SNStatusV2, steffr.ch, Home Assistant forum). Pairing token and full status schema need confirmation on real firmware.",
      "Print start, file upload and camera are not mapped yet. UDP discovery on port 20054 exists but the v2 schema has no UDP channel kind, so it is not expressed here.",
      "SSTP binary control plane (Snapmaker2-Controller): event_id 7 SYS_CTRL, op-codes 3 START_WORK, 4 PAUSE, 5 RESUME, 6 STOP, 1 GET_STATUSES. Firmware transport is UART-to-HMI; LAN reachability over TCP is unconfirmed, so these are documented in the research note and intentionally not added as operations."
    ]
  }
}