{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makerspell.com/schemas/community-printer-profile-v1.json",
  "title": "MakerSpell community printer profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "baseTransport", "match", "permissions", "operations", "ui"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 500 },
    "author": { "type": "string", "maxLength": 100 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
    "baseTransport": { "type": "string", "minLength": 1 },
    "connection": { "$ref": "#/$defs/connection" },
    "repository": { "type": "string", "pattern": "^https://github\\.com/" },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelRegex": { "type": "string" },
        "hostnameRegex": { "type": "string" },
        "serviceTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 }, "uniqueItems": true }
      },
      "minProperties": 1
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["statusRead", "fileListRead", "fileUpload", "printStart", "printControl", "deviceControl", "cameraRead", "gcodeTransform"]
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/operation" },
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$"
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controls", "printOptions"],
      "properties": {
        "controls": { "type": "array", "items": { "$ref": "#/$defs/control" } },
        "printOptions": { "type": "array", "items": { "$ref": "#/$defs/printOption" } }
      }
    }
  },
  "$defs": {
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scheme": { "enum": ["http", "https"], "default": "http" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "basePath": { "type": "string", "pattern": "^(/.*)?$" },
        "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 60000 },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["none", "bearer", "apiKeyHeader", "basic", "usernamePassword"] },
            "header": { "type": "string" },
            "prefix": { "type": "string" },
            "username": { "type": "string" }
          }
        },
        "mqtt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scheme": { "enum": ["mqtt", "mqtts"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "clientId": { "type": "string", "minLength": 1 },
            "keepAliveSeconds": { "type": "integer", "minimum": 5, "maximum": 300 },
            "authentication": { "$ref": "#/$defs/authentication" }
          }
        },
        "ftp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scheme": { "enum": ["ftp", "ftps"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "tlsMode": { "enum": ["implicit", "explicit"] },
            "rootPath": { "type": "string", "pattern": "^/" },
            "authentication": { "$ref": "#/$defs/authentication" }
          }
        },
        "tcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "scheme": { "enum": ["tcp", "tcps"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "lineEnding": { "enum": ["none", "lf", "crlf"] },
            "responseMode": { "enum": ["none", "line", "close"] },
            "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
          }
        },
        "gcode": {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "enum": ["http", "websocket"] },
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string", "pattern": "^/" },
            "command": { "type": "string" },
            "request": { "type": "object" }
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["delegate", "http", "websocket", "mqtt", "ftp", "tcp", "gcode"] },
        "action": { "type": "string" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/" },
        "command": { "type": "string" },
        "topic": { "type": "string", "minLength": 1 },
        "responseTopic": { "type": "string" },
        "qos": { "type": "integer", "minimum": 0, "maximum": 2 },
        "request": { "type": "object" },
        "response": { "type": "object" }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["none", "bearer", "apiKeyHeader", "basic", "usernamePassword"] },
        "header": { "type": "string" },
        "prefix": { "type": "string" },
        "username": { "type": "string" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "operation", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "type": { "enum": ["status", "job", "temperature", "fanList", "slider", "toggle", "button", "motion", "camera", "fileBrowser", "filamentList", "excludeObjects", "printHistory", "timelapseList"] },
        "operation": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "valuePath": { "type": "string" },
        "unit": { "type": "string", "maxLength": 20 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "visibleWhen": { "type": "string", "maxLength": 120 },
        "confirm": { "type": "boolean", "default": false }
      }
    },
    "printOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "operation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "label": { "type": "string", "minLength": 1 },
        "operation": { "type": "string" },
        "default": { "type": "boolean", "default": false }
      }
    }
  }
}
