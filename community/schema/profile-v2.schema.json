{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makerspell.com/schemas/community-printer-profile-v2.json",
  "title": "MakerSpell full JSON printer driver v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "channels", "operations", "state"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "identity": { "type": "object" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "statusRead",
          "fileListRead",
          "fileUpload",
          "printStart",
          "printControl",
          "deviceControl",
          "cameraRead",
          "gcodeTransform"
        ]
      }
    },
    "credentials": { "type": "object" },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 }, "uniqueItems": true },
        "probes": { "type": "array", "items": { "$ref": "#/$defs/probe" } }
      }
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$" },
      "additionalProperties": { "$ref": "#/$defs/channel" }
    },
    "operations": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$" },
      "additionalProperties": { "$ref": "#/$defs/operation" }
    },
    "actions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$" },
      "additionalProperties": { "$ref": "#/$defs/actionBinding" }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controlPanel": { "$ref": "#/$defs/controlPanel" },
        "camera": { "$ref": "#/$defs/camera" }
      }
    },
    "workflows": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$" },
      "additionalProperties": { "$ref": "#/$defs/workflow" }
    },
    "state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            { "type": "string", "pattern": "^\\$" },
            { "$ref": "#/$defs/stateMapping" }
          ]
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pages": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/uiPage" }
        }
      }
    },
    "verification": { "type": "object" }
  },
  "$defs": {
    "controlPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel"],
      "properties": {
        "channel": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" },
        "query": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
          }
        }
      }
    },
    "actionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation"],
      "properties": {
        "operation": { "type": "string" },
        "arguments": {
          "type": "object",
          "maxProperties": 24,
          "additionalProperties": { "$ref": "#/$defs/actionArgument" }
        }
      }
    },
    "actionArgument": {
      "oneOf": [
        {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": { "enum": ["value", "enabled", "axis", "axes", "fanId"] },
            "value": {},
            "default": {},
            "scale": { "type": "number", "minimum": -100000, "maximum": 100000 },
            "clamp": {
              "type": "array",
              "prefixItems": [{ "type": "number" }, { "type": "number" }],
              "minItems": 2,
              "maxItems": 2
            },
            "round": { "type": "boolean" },
            "uppercase": { "type": "boolean" },
            "required": { "type": "boolean" },
            "allowed": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "number" },
                  { "type": "boolean" }
                ]
              }
            },
            "nonZero": { "type": "boolean" },
            "enum": { "type": "object" }
          },
          "anyOf": [
            {
              "properties": { "from": {} },
              "required": ["from"]
            },
            {
              "properties": { "value": {} },
              "required": ["value"]
            }
          ]
        }
      ]
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "path", "kind"],
            "properties": {
              "id": { "type": "string", "maxLength": 80 },
              "channel": { "type": "string" },
              "path": { "type": "string", "pattern": "^/" },
              "query": {
                "type": "object",
                "maxProperties": 16,
                "additionalProperties": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "number" },
                    { "type": "boolean" }
                  ]
                }
              },
              "kind": { "enum": ["snapshot", "mjpeg", "webPage", "webRtc", "flv", "rtsp"] },
              "snapshotRefreshMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
              "cacheable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scheme", "port"],
      "properties": {
        "kind": { "enum": ["http", "websocket", "mqtt", "ftp", "tcp"] },
        "scheme": { "enum": ["http", "https", "ws", "wss", "mqtt", "mqtts", "ftp", "ftps", "tcp", "tcps"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "pattern": "^(/.*)?$" },
        "timeoutMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
        "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "lifecycle": { "enum": ["perOperation", "session"] }
        ,"clientId": { "type": "string", "minLength": 1, "maxLength": 128 }
        ,"keepAliveSeconds": { "type": "integer", "minimum": 5, "maximum": 300 }
        ,"lineEnding": { "enum": ["none", "lf", "crlf"] }
        ,"responseMode": { "enum": ["none", "line", "close"] }
        ,"tlsMode": { "enum": ["implicit", "explicit"] }
        ,"rootPath": { "type": "string", "pattern": "^/" }
        ,"username": { "type": "string", "maxLength": 128 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel"],
      "properties": {
        "channel": { "type": "string" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^(/.*)?$" },
        "send": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "json": {},
            "text": { "type": "string" },
            "headers": { "type": "object" },
            "query": { "type": "object" },
            "multipart": { "$ref": "#/$defs/multipart" }
            ,"topic": { "type": "string", "minLength": 1, "maxLength": 512 }
            ,"responseTopic": { "type": "string", "maxLength": 512 }
            ,"qos": { "type": "integer", "minimum": 0, "maximum": 2 }
            ,"ftpAction": { "enum": ["list", "upload", "delete"] }
            ,"bytesVariable": { "type": "string" }
          }
        },
        "receive": { "$ref": "#/$defs/receive" },
        "map": { "type": "string" }
      }
    },
    "multipart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "fields": { "type": "object" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "filename", "bytesVariable"],
            "properties": {
              "field": { "type": "string" },
              "filename": { "type": "string" },
              "bytesVariable": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "maxExecutedSteps": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workflowStep" }
        }
      }
    },
    "workflowStep": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "operation"],
          "properties": {
            "type": { "const": "operation" },
            "operation": { "type": "string" },
            "saveAs": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "condition", "then"],
          "properties": {
            "type": { "const": "branch" },
            "condition": { "$ref": "#/$defs/condition" },
            "then": { "type": "array", "items": { "$ref": "#/$defs/workflowStep" } },
            "else": { "type": "array", "items": { "$ref": "#/$defs/workflowStep" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "milliseconds"],
          "properties": {
            "type": { "const": "wait" },
            "milliseconds": { "type": "integer", "minimum": 0, "maximum": 30000 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "maxAttempts", "steps"],
          "properties": {
            "type": { "const": "retry" },
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 20 },
            "delayMilliseconds": { "type": "integer", "minimum": 0, "maximum": 30000 },
            "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workflowStep" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "set" },
            "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
            "value": {},
            "from": { "type": "string", "pattern": "^\\$" },
            "select": { "$ref": "#/$defs/selector" }
          },
          "oneOf": [
            { "required": ["value"], "properties": { "value": {} } },
            { "required": ["from"], "properties": { "from": {} } },
            { "required": ["select"], "properties": { "select": {} } }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "condition"],
          "properties": {
            "type": { "const": "assert" },
            "condition": { "$ref": "#/$defs/condition" },
            "message": { "type": "string", "maxLength": 300 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "stage"],
          "properties": {
            "type": { "const": "emit" },
            "stage": { "type": "string", "maxLength": 80 },
            "progress": { "type": "number", "minimum": 0, "maximum": 1 },
            "message": { "type": "string", "maxLength": 300 }
          },
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "pattern": "^\\$" },
        "variable": { "type": "string" },
        "equals": {},
        "notEquals": {},
        "exists": { "type": "boolean" }
      },
      "oneOf": [
        { "required": ["path"], "properties": { "path": {} } },
        { "required": ["variable"], "properties": { "variable": {} } }
      ],
      "additionalProperties": false
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "where", "valuePath"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^\\$" }
        },
        "where": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "pattern": "^\\$" },
            "equals": {},
            "equalsVariable": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
            "caseInsensitive": { "type": "boolean" },
            "basename": { "type": "boolean" }
          },
          "oneOf": [
            { "required": ["equals"], "properties": { "equals": {} } },
            { "required": ["equalsVariable"], "properties": { "equalsVariable": {} } }
          ]
        },
        "valuePath": { "type": "string", "pattern": "^\\$" },
        "default": {}
      }
    },
    "uiPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "layout": { "enum": ["adaptiveDashboard", "list"] },
        "sections": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/uiSection" }
        }
      }
    },
    "uiSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "bind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$" },
        "component": {
          "enum": ["printerStatus", "activeJob", "temperatureControls", "fanControls", "deviceControls", "camera", "fileBrowser", "filamentBay", "motionControls", "excludeObjects", "deviceInterface", "printHistory", "timelapses"]
        },
        "bind": { "type": "string", "pattern": "^printer(?:\\..+)?$" },
        "title": {
          "oneOf": [
            { "type": "string", "maxLength": 120 },
            {
              "type": "object",
              "additionalProperties": { "type": "string", "maxLength": 120 }
            }
          ]
        },
        "minWidth": { "type": "number", "minimum": 200, "maximum": 1200 }
      }
    },
    "receive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["none", "first", "matching", "close"] },
        "maxMessages": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "until": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pathExists": { "type": "string", "pattern": "^\\$" },
            "pathExistsAny": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "pattern": "^\\$" }
            },
            "equals": {
              "type": "object",
              "required": ["path", "value"],
              "properties": { "path": { "type": "string", "pattern": "^\\$" }, "value": {} }
            }
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation"],
      "properties": {
        "operation": { "type": "string" },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "required": { "type": "boolean" }
      }
    },
    "stateMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^\\$" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^\\$" }
        },
        "value": {},
        "default": {},
        "scale": { "type": "number" },
        "enum": { "type": "object" },
        "fallbackDelimited": { "$ref": "#/$defs/delimitedDecoder" },
        "expand": { "$ref": "#/$defs/nestedExpansion" },
        "items": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "pattern": "^\\$" },
              { "$ref": "#/$defs/fieldMapping" }
            ]
          }
        },
        "compose": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "$includeWhenAny": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": { "type": "string", "pattern": "^\\$" }
              }
            },
            "additionalProperties": {
              "oneOf": [
                { "type": "string", "pattern": "^\\$" },
                { "$ref": "#/$defs/fieldMapping" }
              ]
            }
          }
        }
      },
      "anyOf": [
        { "required": ["path"], "properties": { "path": {} } },
        { "required": ["paths"], "properties": { "paths": {} } },
        { "required": ["value"], "properties": { "value": {} } },
        { "required": ["compose"], "properties": { "compose": {} } },
        { "required": ["expand"], "properties": { "expand": {} } }
      ]
    },
    "nestedExpansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["childrenPath", "fields"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\$" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^\\$" }
        },
        "childrenPath": { "type": "string", "pattern": "^\\$" },
        "minimumChildren": { "type": "integer", "minimum": 0, "maximum": 32 },
        "maxOutput": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "pattern": "^\\$" },
              { "$ref": "#/$defs/fieldMapping" }
            ]
          }
        },
        "fallback": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "object" }
        }
      },
      "anyOf": [
        { "required": ["path"], "properties": { "path": {} } },
        { "required": ["paths"], "properties": { "paths": {} } }
      ]
    },
    "delimitedDecoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fields"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\$" },
        "recordSeparator": { "type": "string", "minLength": 1, "maxLength": 4 },
        "fieldSeparator": { "type": "string", "minLength": 1, "maxLength": 4 },
        "maxRecords": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maxFields": { "type": "integer", "minimum": 1, "maximum": 64 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "oneOf": [
              { "type": "integer", "minimum": 0, "maximum": 63 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["index"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0, "maximum": 63 },
                  "type": { "enum": ["string", "int", "double"] }
                }
              }
            ]
          }
        },
        "templates": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^\\$" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^\\$" }
        },
        "value": {},
        "default": {},
        "scale": { "type": "number" },
        "enum": { "type": "object" }
      },
      "anyOf": [
        { "required": ["path"], "properties": { "path": {} } },
        { "required": ["paths"], "properties": { "paths": {} } },
        { "required": ["value"], "properties": { "value": {} } }
      ]
    }
  }
}
