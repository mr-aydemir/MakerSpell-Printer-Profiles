{
  "$schema": "../schema/profile-v2.schema.json",
  "schemaVersion": 2,
  "id": "community.mks-v2.bridge",
  "version": "2.0.0",
  "identity": {
    "name": "MKS WiFi v2 Compatibility Bridge",
    "status": "compatibilityBridge",
    "replaces": "mks",
    "delegateContracts": [
      "capabilities",
      "filamentSlots",
      "probe",
      "startPrint",
      "status",
      "upload"
    ],
    "migration": {
      "sourceAdapter": "mks",
      "sourceFile": "makersync_app/lib/services/transports/mks_transport.dart",
      "protocols": [
        "HTTP",
        "TCP console"
      ],
      "authentication": "none",
      "probeSummary": "MKS TCP console acknowledges M105.",
      "remainingWork": "Replace each declared delegate with schema-v2 operations, state mappings, workflows and conformance evidence."
    }
  },
  "permissions": [
    "fileUpload",
    "printStart",
    "statusRead"
  ],
  "credentials": {
    "type": "none"
  },
  "supportedFileTypes": [
    "gcode"
  ],
  "printPreparation": {
    "filamentMappingMode": "unsupported",
    "calibrationMode": "unsupported",
    "autoLevelingMode": "unsupported",
    "supportsFlowCalibration": false,
    "supportsTimelapseCapture": false
  },
  "discovery": {
    "serviceTypes": [
      "_mks._tcp.local"
    ],
    "ports": [
      80,
      8080
    ],
    "probes": []
  },
  "channels": {
    "web": {
      "kind": "http",
      "scheme": "http",
      "port": 80,
      "timeoutMs": 10000,
      "maxResponseBytes": 1048576
    },
    "console": {
      "kind": "tcp",
      "scheme": "tcp",
      "port": 8080,
      "timeoutMs": 10000,
      "maxResponseBytes": 1048576
    }
  },
  "operations": {},
  "workflows": {},
  "state": {},
  "ui": {
    "pages": {
      "control": {
        "layout": "adaptiveDashboard",
        "sections": [
          {
            "id": "status",
            "component": "printerStatus",
            "bind": "printer.connection",
            "title": {
              "en": "Printer status",
              "tr": "Yazıcı durumu"
            }
          }
        ]
      }
    }
  },
  "verification": {
    "level": "compatibilityBridge",
    "sourceSupportLevel": "experimental",
    "testedOperations": [],
    "untestedOperations": [
      "capabilities",
      "filamentSlots",
      "probe",
      "startPrint",
      "status",
      "upload"
    ]
  }
}
