{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makerspell.com/schemas/community-printer-catalog-v1.json",
  "title": "MakerSpell community printer catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "sha256"],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/[0-9a-fA-F]{40}/"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    }
  }
}
