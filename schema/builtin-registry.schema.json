{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makerspell.com/schemas/builtin-printer-registry-v1.json",
  "title": "MakerSpell built-in printer adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "notice", "adapters"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceRepository", "registrySource", "generatedBy"],
      "properties": {
        "name": { "const": "MakerSpell" },
        "version": { "type": "string" },
        "sourceRepository": { "type": "string", "format": "uri" },
        "registrySource": { "type": "string" },
        "generatedBy": { "type": "string" }
      }
    },
    "notice": { "type": "string" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/adapter" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "displayName", "supportLevel", "sourceFile", "connection", "capabilities", "contracts", "ui"],
      "properties": {
        "order": { "type": "integer", "minimum": 0 },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "supportLevel": { "enum": ["verified", "communityVerified", "protocolCompatible", "experimental", "unsupported"] },
        "sourceFile": { "type": "string", "pattern": "^makersync_app/lib/services/transports/.+\\.dart$" },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serviceTypes", "defaultPorts", "protocols", "authentication", "probeSummary"],
          "properties": {
            "serviceTypes": { "$ref": "#/$defs/stringArray" },
            "defaultPorts": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 }, "uniqueItems": true },
            "protocols": { "$ref": "#/$defs/stringArray" },
            "authentication": { "type": "string" },
            "probeSummary": { "type": "string" }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "supportedFileTypes"],
          "properties": {
            "baseline": { "$ref": "#/$defs/stringArray" },
            "supportedFileTypes": { "$ref": "#/$defs/stringArray" },
            "conditional": { "$ref": "#/$defs/stringArray" }
          }
        },
        "contracts": { "$ref": "#/$defs/stringArray" },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sections", "jobControls", "deviceControls", "printOptions"],
          "properties": {
            "sections": { "$ref": "#/$defs/stringArray" },
            "jobControls": { "$ref": "#/$defs/stringArray" },
            "deviceControls": { "$ref": "#/$defs/stringArray" },
            "printOptions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["filamentMappingMode", "calibrationMode", "autoLevelingMode", "supportsFlowCalibration", "supportsTimelapseCapture", "resolvedFromFirmware"],
              "properties": {
                "filamentMappingMode": { "type": "string" },
                "calibrationMode": { "type": "string" },
                "autoLevelingMode": { "type": "string" },
                "supportsFlowCalibration": { "type": "boolean" },
                "supportsTimelapseCapture": { "type": "boolean" },
                "resolvedFromFirmware": { "type": "boolean" },
                "dynamicCandidates": { "$ref": "#/$defs/stringArray" }
              }
            }
          }
        },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
